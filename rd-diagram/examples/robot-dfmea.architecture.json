    {
      "dot": "rose",
      "title": "DFMEA 顶层结论",
      "items": [
        "最高严酷度：主控失效 / 急停链失效 → S=10（人身安全），现有措施：双路安全继电器 + 看门狗",
        "高频失效模式：轮组打滑导致里程计漂移（O=6），规划增加视觉里程计融合",
        "接口风险：充电桩极板虚接（S=4/O=5），列入设计改进：增加对接到位检测"
      ]
    },
    {
      "dot": "cyan",
      "title": "边界划分原则",
      "items": [
        "按物理模块划分六域，域内失效不跨域传播",
        "安全链（急停）独立于控制域，直连配电"
      ]
    }
  ]
